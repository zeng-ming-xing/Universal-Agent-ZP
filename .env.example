# ============================
# 项目统一配置文件
# 所有环境变量必须在此定义，代码中不应再有任何默认值
# ============================

# ========== MySQL 连接 ==========
MYSQL_HOST=127.0.0.1
MYSQL_PORT=5000
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# 执行 prisma db pull 时，DATABASE_URL 必须指向真实业务库（已由 sys 迁至 test）
DATABASE_URL="mysql://root:your_mysql_password@127.0.0.1:5000/test?connection_limit=5"

# ========== mysql-service ==========
AGENT_MYSQL_SERVICE_PORT=37123
# renderer 进程通过 axios 直连 mysql-service
VITE_MYSQL_SERVICE_PORT=37123
AGENT_MYSQL_MAX_ROWS=1000
AGENT_MYSQL_DEFAULT_PAGE_SIZE=200
AGENT_MYSQL_MAX_OFFSET=200000
AGENT_MYSQL_MAX_EXECUTION_TIME_MS=15000
AGENT_MYSQL_FILTER_SYSTEM_DATABASES=true
AGENT_MYSQL_INCLUDE_VIEWS=false

# ========== PostgreSQL 向量库（pgvector） ==========
# 独立 schema：prisma/vector.prisma，独立生成到 node_modules/.prisma/vector-client
# 执行 `pnpm prisma:push:vector` 会按该 URL 同步结构（改 embedding-dimension  后务必执行）
VECTOR_DATABASE_URL="postgresql://root:your_pg_password@localhost:5432/postgres?schema=public&connection_limit=5"

# ========== Docker 容器配置 ==========
PG_USER=root
PG_PASSWORD=your_pg_password
PG_PORT=5432

# ========== 模型配置（智谱 GLM） ==========
AGENT_MODEL_NAME=glm-4.7
AGENT_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_EMBEDDINGS_KEY=your_zhipu_embeddings_key

# ========== RAG Embedding 参数（维度须与 prisma/vector.prisma 中 vector(N) 一致；方舟 API 支持降维） ==========
RAG_EMBEDDING_DIM=1024
# 可选：单独指定请求方舟时的 dimensions，不设则与 RAG_EMBEDDING_DIM 相同
# ARK_EMBEDDING_DIMENSIONS=1024
RAG_INGEST_EMBEDDING_BATCH_SIZE=16
RAG_DEFAULT_SERVE_TIMEOUT_MS=20000
RAG_DEFAULT_EMBEDDING_TIMEOUT_MS=15000
VECTOR_SEARCH_DEFAULT_LIMIT=10
VECTOR_SEARCH_MAX_LIMIT=100

# ========== 联网搜索（Tavily MCP） ==========
TAVILY_API_KEY=your_tavily_api_key
TAVILY_MCP_ENDPOINT=https://mcp.tavily.com/mcp/
AGENT_WEB_SEARCH_TIMEOUT_MS=20000
AGENT_WEB_SEARCH_MAX_RESULTS=5

# ========== Agent 运行时参数 ==========
AGENT_EVENT_DEDUP_LIMIT=300
AGENT_RECURSION_LIMIT=80
AGENT_WORKSPACE_ROOT=
AGENT_MAX_READ_BYTES=524288
AGENT_COMMAND_TIMEOUT_MS=60000
AGENT_MAX_COMMAND_OUTPUT_CHARS=32000
AGENT_SKILLS_ROOT=.agents/skills

# ========== SQL 工具参数 ==========
AGENT_SQL_PAGE_SIZE_THRESHOLD=200
AGENT_SQL_QUERY_PAGE_SIZE=200

# ========== 格式化/截断参数 ==========
AGENT_MYSQL_SCHEMA_CATALOG_MAX_CHARS=16000
AGENT_RAG_DOCUMENTS_PROMPT_MAX_CHARS=12000
AGENT_RAG_SINGLE_SUMMARY_MAX_CHARS=1200
